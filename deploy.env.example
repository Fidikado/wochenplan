# Zugangsdaten fuer das Deployment.
#
# SO BENUTZEN:
#   cp deploy.env.example deploy.env
#   danach deploy.env ausfuellen
#
# deploy.env steht in .gitignore und wird nie committet oder gepusht.
# Diese Vorlage hier enthaelt nur Platzhalter und darf im Repo liegen.
#
# Trage deine echten Werte AUSSCHLIESSLICH in deploy.env ein, niemals hier.


# --- Verfahren -----------------------------------------------------------
# ftp   = FTP mit TLS (die meisten Webhoster)
# sftp  = SFTP ueber SSH
# rsync = rsync ueber SSH (am schnellsten, braucht SSH-Zugang)
DEPLOY_METHOD=ftp


# --- Server --------------------------------------------------------------
DEPLOY_HOST=ftp.deinhoster.de
DEPLOY_USER=dein-benutzername

# Passwort. Bei sftp/rsync leer lassen, wenn du einen SSH-Schluessel nutzt.
DEPLOY_PASS=

# Nur fuer sftp/rsync: Pfad zum privaten SSH-Schluessel.
# Ein Schluessel ist einem Passwort immer vorzuziehen.
DEPLOY_SSH_KEY=

# Port. Leer lassen fuer den Standard (21 bei FTP, 22 bei SFTP/rsync).
DEPLOY_PORT=


# --- Zielverzeichnis auf dem Server ---------------------------------------
# Der Ordner, der im Browser erscheint. Je nach Hoster z. B.
#   /httpdocs, /public_html, /html, /www oder /var/www/html/rezeptbuch
DEPLOY_PATH=/httpdocs


# --- Adresse der fertigen Seite -------------------------------------------
# Nur fuer die Ausgabe am Ende, damit du direkt draufklicken kannst.
DEPLOY_URL=https://deine-domain.de
